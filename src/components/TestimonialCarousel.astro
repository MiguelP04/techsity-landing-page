---
import { Quote } from "lucide-astro";

const testimonials = [
  {
    name: "Jose Ruiz",
    role: "Full Stack Developer",
    image: "/team/carlos.jpg",
    review:
      "¡Programar en Techsity es otro nivel! Usar IA para potenciar nuestro flujo de trabajo no solo nos hace más rápidos, sino que nos permite enfocarnos en lo que realmente importa: crear soluciones disruptivas que vuelan la cabeza.",
  },
  {
    name: "William Pinto",
    role: "Full Stack Developer",
    image: "/team/maria.jpg",
    review:
      "Techsity es un gran lugar para trabajar. Los desafíos son constantes y la oportunidad de aprender es infinita.",
  },
  {
    name: "Miguel Petit",
    role: "Full Stack Developer",
    image: "/team/andres.jpg",
    review:
      "En Techsity construimos sistemas escalables y robustos. La pasión por el código limpio y las mejores prácticas nos distingue en cada proyecto que emprendemos.",
  },
];
---

<div class="testimonial-carousel relative">
  <div class="carousel-container">
    {
      testimonials.map((testimonial, index) => (
        <div class="testimonial-slide" data-index={index}>
          <div class="flex flex-col items-center gap-6 max-w-2xl mx-auto">
            {/* Review y datos - ARRIBA */}
            <div class="text-center w-full">
              <Quote class="w-10 h-10 text-primary/30 mb-4 mx-auto" />
              <p class="text-lg text-gray-200 leading-relaxed mb-6 italic line-clamp-4">
                "{testimonial.review}"
              </p>
            </div>

            {/* Foto circular del desarrollador - ABAJO */}
            <div class="flex-shrink-0">
              <div class="relative">
                <div class="absolute inset-0 bg-gradient-to-br from-primary to-accent rounded-full blur-xl opacity-40 animate-pulse" />
                <img
                  src={testimonial.image}
                  alt={testimonial.name}
                  class="relative w-40 h-40 md:w-48 md:h-48 rounded-full object-cover border-4 border-white shadow-2xl"
                />
              </div>
            </div>

            {/* Nombre y rol */}
            <div class="text-center">
              <h4 class="text-xl font-bold text-white">{testimonial.name}</h4>
              <p class="text-primary font-medium">{testimonial.role}</p>
            </div>
          </div>
        </div>
      ))
    }
  </div>

  {/* Indicadores */}
  <div class="flex justify-center gap-2 mt-8">
    {
      testimonials.map((_, index) => (
        <button
          class="indicator"
          data-index={index}
          aria-label={`Ver testimonio ${index + 1}`}
        />
      ))
    }
  </div>
</div>

<style>
  .carousel-container {
    position: relative;
    min-height: 500px;
    height: 500px;
  }

  .testimonial-slide {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    opacity: 0;
    transform: translateX(30px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .testimonial-slide.active {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
    position: relative;
  }

  .indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .indicator:hover {
    background-color: rgba(255, 255, 255, 0.5);
    transform: scale(1.2);
  }

  .indicator.active {
    background-color: var(--color-primary);
    width: 32px;
    border-radius: 6px;
  }

  @media (max-width: 768px) {
    .carousel-container {
      min-height: 550px;
      height: 550px;
    }
  }
</style>

<script>
  const slides = document.querySelectorAll(".testimonial-slide");
  const indicators = document.querySelectorAll(".indicator");
  let currentIndex = 0;
  let intervalId: number;

  function showSlide(index: number) {
    // Remover active de todos
    slides.forEach((slide) => slide.classList.remove("active"));
    indicators.forEach((indicator) => indicator.classList.remove("active"));

    // Activar el slide e indicador actual
    slides[index].classList.add("active");
    indicators[index].classList.add("active");
    currentIndex = index;
  }

  function nextSlide() {
    const next = (currentIndex + 1) % slides.length;
    showSlide(next);
  }

  function startCarousel() {
    intervalId = window.setInterval(nextSlide, 3500); // 3 segundos
  }

  function stopCarousel() {
    clearInterval(intervalId);
  }

  // Event listeners para los indicadores
  indicators.forEach((indicator, index) => {
    indicator.addEventListener("click", () => {
      stopCarousel();
      showSlide(index);
      startCarousel(); // Reiniciar el auto-play
    });
  });

  // Pausar en hover (opcional pero mejora UX)
  const carousel = document.querySelector(".testimonial-carousel");
  carousel?.addEventListener("mouseenter", stopCarousel);
  carousel?.addEventListener("mouseleave", startCarousel);

  // Inicializar mostrando el primer slide
  showSlide(0);

  // Iniciar el carrusel automático
  startCarousel();
</script>

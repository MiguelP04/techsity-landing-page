---
const team = [
  {
    name: "Jose Ruiz",
    profession: "Ingeniero de Sistemas",
    position: "CEO & Full Stack Developer",
    image: "/team/JOSE.jpeg",
    photoPosition: "center 30%",
    review: "Soy CEO de Techsity, una empresa dedicada al desarrollo de software. Me apasiona la tecnología y la innovación, tengo años de experiencia en el mercado de tecnologia con capacidad para adaptarse a tendencias emergentes",
    socials: {
      github: "https://github.com/joseruizvene",
      instagram: "https://www.instagram.com/goitiajose23?igsh=Yzh6cDZuNGdrYmFw",
      linkedin: "https://www.linkedin.com/in/jose-leonardo-ruiz-goitia-a4912a2b3?utm_source=share&utm_campaign=share_via&utm_content=profile&utm_medium=android_app"
    }
  },
  {
    name: "William Pinto",
    profession: "Ingeniero de Sistemas",
    position: "CTO & Full Stack Developer",
    image: "/team/WILLIAM2.jpg",
    photoPosition: "center center",
    review: "En Techsity lidero la visión tecnológica y el desarrollo de nuestra arquitectura. Me enfoco en diseñar software de alta calidad y soluciones innovadoras que impulsen el éxito de nuestros clientes, respaldadas por un código limpio y escalable.",
    socials: {
      github: "https://github.com/Williamp0403",
      instagram: "https://www.instagram.com/williamjp0403/",
      linkedin: "https://www.linkedin.com/in/william-pinto04-dev/"
    }
  },
  {
    name: "Miguel Petit",
    profession: "Ingeniero de Sistemas",
    position: "Co-founder & Full Stack Developer",
    image: "/team/MIGUEL.jpeg",
    photoPosition: "center center",
    review: "En Techsity, determinamos las estrategias y herramientas que automatizan tu negocio. Mi compromiso es ser el socio técnico que te ayude a resolver tareas complejas y a escalar profesionalmente mediante la innovación y el acompañamiento constante.",
    socials: {
      github: "https://github.com/MiguelP04",
      instagram: "https://www.instagram.com/md_p67",
      linkedin: "https://www.linkedin.com/in/miguel-petit-dev/"
    }
  },
];
---
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&display=swap" rel="stylesheet"/>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet"/>

<!-- Contenedor general centrado -->
<div class="team-template-wrapper w-full flex justify-center py-4 md:py-16 px-4 md:px-8 relative z-10">
  
  <!-- Main Card (Transparent with Borders) -->
  <div class="relative w-full max-w-6xl flex flex-col md:flex-row bg-transparent mx-auto min-h-[600px] border border-border md:border-white/20 dark:border-white/20 rounded-2xl overflow-hidden shadow-lg md:shadow-[0_0_50px_rgba(0,0,0,0.3)]">
    
    <!-- Video Background Removed (Now at section level) -->
    
    <!-- Top Left Brand/Nav -->
    <div class="absolute top-0 left-0 md:top-8 md:left-8 z-30 flex items-center space-x-2 w-full md:w-auto justify-center md:justify-start mt-4 md:mt-0">
      <span class="text-xl font-bold tracking-widest text-heading md:text-white dark:text-white uppercase drop-shadow-md transition-colors duration-300">Techsity</span>
      <div class="w-8 h-px bg-primary drop-shadow-md"></div>
      <span class="text-xs tracking-widest text-body-secondary md:text-gray-300 dark:text-gray-300 uppercase drop-shadow-md transition-colors duration-300">Equipo</span>
    </div>

    <!-- Left Vertical Nav (Nombres interactivos) -->
    <div class="hidden md:flex w-24 flex-col justify-end items-center pb-16 z-20 border-r border-white/10 shrink-0">
      <nav class="flex flex-col space-y-12 items-center" id="verticalNav">
        {team.map((member, index) => (
          <button class="vertical-nav-btn relative flex items-center justify-center group" data-index={index} aria-label={`Ver perfil de ${member.name}`}>
            <span class="nav-text vertical-text text-sm uppercase tracking-widest font-semibold transition-colors duration-300 text-gray-400 group-hover:text-primary">
              {member.name.split(' ')[0]}
            </span>
            <!-- Indicador activo (línea verde) -->
            <div class="nav-indicator absolute -right-[43px] top-1/2 -translate-y-1/2 w-[3px] h-8 bg-primary opacity-0 transition-opacity duration-300"></div>
          </button>
        ))}
      </nav>
    </div>

    <!-- Core Interactive Area -->
    <div class="flex-1 relative flex flex-col md:flex-row items-center pt-16 pb-16 md:py-0 md:pl-16 md:pr-24">
      
      <!-- Cards Container (All members stacked here grid for proper height expansion on mobile) -->
      <div class="w-full h-full relative grid grid-cols-1 grid-rows-1" id="teamProfilesContainer">
        
        {team.map((member, index) => (
          <div class="team-profile-slide col-start-1 row-start-1 flex flex-col md:flex-row items-center w-full opacity-0 pointer-events-none transition-opacity duration-700 ease-in-out" data-index={index}>
            
            <!-- Left Image Card -->
            <div class="relative w-[280px] md:w-[350px] aspect-[3/4] md:h-[450px] z-20 shadow-2xl bg-slate-900 border border-border md:border-white/10 dark:border-white/10 rounded-lg shrink-0 overflow-hidden group mx-auto md:mx-0 md:absolute md:left-0 md:top-1/2 md:-translate-y-1/2 mb-8 md:mb-0">
              <div class="absolute inset-0 md:bg-primary/20 mix-blend-overlay z-10 pointer-events-none md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500"></div>
              <img 
                alt={`Retrato de ${member.name}`} 
                class="w-full h-full object-cover transition-all duration-700 md:grayscale md:opacity-90 md:group-hover:scale-105 md:group-hover:grayscale-0 md:group-hover:opacity-100 md:group-hover:mix-blend-normal md:mix-blend-screen" 
                src={member.image}
                style={`object-position: ${member.photoPosition};`}
              />
            </div>
            
            <!-- Right Content -->
            <div class="w-full md:ml-[380px] max-w-lg z-10 flex flex-col justify-center text-center md:text-left drop-shadow-lg mx-auto md:mx-0">
              <div class="w-16 h-0.5 bg-primary mb-6 hidden md:block"></div>
              
              <h3 class="signature-font text-5xl md:text-6xl mb-2 text-heading md:text-white dark:text-white transition-colors duration-300">{member.name}</h3>
              <p class="text-xs md:text-sm uppercase tracking-[0.2em] text-primary mb-6 md:mb-8 font-semibold">{member.profession}</p>
              
              <p class="text-sm md:text-base leading-relaxed text-body md:text-gray-200 dark:text-gray-200 transition-colors duration-300 mb-4 md:mb-6 italic px-4 md:px-0 bg-surface-alt/40 md:bg-transparent backdrop-blur-sm md:backdrop-blur-none p-4 md:p-0 rounded-lg md:rounded-none text-left">
                "{member.review}"
              </p>
              
              <!-- Cargo centrado debajo de la review -->
              <p class="position-label text-xs uppercase tracking-widest text-gray-400 font-bold text-center mb-8 md:mb-12">
                {member.position}
              </p>
              
              <!-- Social row -->
              <div class="flex items-center justify-center md:justify-start space-x-6">
                <a class="text-body-secondary md:text-gray-300 dark:text-gray-300 transition-colors duration-300 hover:text-primary transition-colors hover:scale-110 transform" href={member.socials.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                  <i class="fab fa-github text-lg md:text-xl"></i>
                </a>
                <a class="text-body-secondary md:text-gray-300 dark:text-gray-300 transition-colors duration-300 hover:text-primary transition-colors hover:scale-110 transform" href={member.socials.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <i class="fab fa-instagram text-lg md:text-xl"></i>
                </a>
                <a class="text-body-secondary md:text-gray-300 dark:text-gray-300 transition-colors duration-300 hover:text-primary transition-colors hover:scale-110 transform" href={member.socials.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                  <i class="fab fa-linkedin-in text-lg md:text-xl"></i>
                </a>
                
                <!-- Dot indicator graphic (Solo se muestra en móvil porque en PC está la barra vertical) -->
                <div class="flex md:hidden space-x-2 ml-4 dots-indicator">
                  {team.map((_, dotIndex) => (
                    <span class={`w-2 h-2 rounded-full transition-colors duration-300 ${index === dotIndex ? 'bg-primary' : 'bg-body-secondary dark:bg-gray-500 opacity-50'}`}></span>
                  ))}
                </div>
              </div>
            </div>

          </div>
        ))}
        
      </div>

    </div>

    <!-- Navigation Buttons -->
    <div class="absolute right-1/2 translate-x-1/2 bottom-0 md:translate-x-0 md:right-0 md:top-auto md:bottom-24 flex flex-row md:flex-col z-30 shadow-xl rounded-lg md:rounded-none overflow-hidden border border-border md:border-white/10 dark:border-white/10 md:border-none">
      <button id="tplNextBtn" class="order-2 md:order-1 bg-primary/90 backdrop-blur-md w-14 h-14 flex items-center justify-center hover:bg-white text-heading md:text-slate-950 dark:text-slate-950 transition-colors md:border-b border-black/10" aria-label="Siguiente perfil">
        <i class="fas fa-arrow-right text-lg"></i>
      </button>
      <button id="tplPrevBtn" class="order-1 md:order-2 bg-primary/90 backdrop-blur-md w-14 h-14 flex items-center justify-center hover:bg-white text-heading md:text-slate-950 dark:text-slate-950 transition-colors border-r md:border-r-0 border-black/10" aria-label="Perfil anterior">
        <i class="fas fa-arrow-left text-lg"></i>
      </button>
    </div>

  </div>
</div>

<style>
  .signature-font {
    font-family: 'Caveat', cursive;
    text-shadow: 0 2px 10px rgba(0,0,0,0.5);
  }
  
  .vertical-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  /* Slider Logic CSS */
  .team-profile-slide {
    grid-column: 1;
    grid-row: 1;
  }

  .team-profile-slide.active {
    opacity: 1;
    pointer-events: auto;
    z-index: 20;
  }

  /* Entry animations for the content when active */
  .team-profile-slide.active h3 {
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .team-profile-slide.active p {
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.1s forwards opacity-0;
  }
  .team-profile-slide.active .position-label {
    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards opacity-0;
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .opacity-0 {
    opacity: 0;
  }

  /* Vertical Nav Active States */
  .vertical-nav-btn.active .nav-text {
    color: #ffffff;
  }
  
  .vertical-nav-btn.active .nav-indicator {
    opacity: 1;
  }

  /* Tailwind mappings just in case */
  .bg-primary {
    background-color: var(--color-primary);
  }
  .text-primary {
    color: var(--color-primary);
  }
</style>

<script>
  function initNewTeamCarousel() {
    const slides = Array.from(document.querySelectorAll('.team-profile-slide')) as HTMLElement[];
    const navBtns = Array.from(document.querySelectorAll('.vertical-nav-btn')) as HTMLButtonElement[];
    const nextBtn = document.getElementById('tplNextBtn');
    const prevBtn = document.getElementById('tplPrevBtn');
    
    if (slides.length === 0 || !nextBtn || !prevBtn) return;

    let currentIndex = 0;
    const total = slides.length;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index);
      });
      
      navBtns.forEach((btn, i) => {
        btn.classList.toggle('active', i === index);
      });
    }

    nextBtn.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % total;
      showSlide(currentIndex);
    });

    prevBtn.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + total) % total;
      showSlide(currentIndex);
    });

    // Vertical Nav Click
    navBtns.forEach((btn, i) => {
      btn.addEventListener('click', () => {
        currentIndex = i;
        showSlide(currentIndex);
      });
    });

    // Show first slide initially
    showSlide(0);
  }

  document.addEventListener("DOMContentLoaded", initNewTeamCarousel);
  document.addEventListener("astro:page-load", initNewTeamCarousel);
</script>

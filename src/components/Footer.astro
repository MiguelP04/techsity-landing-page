---
import { Linkedin, Instagram, Mail, Phone, MapPin } from "lucide-astro";
import { Image } from "astro:assets";
import logo from "../assets/logo_transparent_small.svg";
import TikTok from "./icons/TikTok.astro";

interface Props {
  animate?: boolean;
}

const { animate = true } = Astro.props;

const currentYear = new Date().getFullYear();

const quickLinks = [
  { name: "Inicio", href: "#inicio" },
  { name: "Servicios", href: "#servicios" },
  { name: "Sobre Nosotros", href: "#nosotros" },
  { name: "¿Por qué elegirnos?", href: "#por-que-elegirnos" },
  { name: "Contacto", href: "#contacto" },
];

const socials = [
  {
    Icon: Linkedin,
    href: "https://www.linkedin.com/in/techsity-solutions-dev/",
    label: "LinkedIn",
  },
  {
    Icon: Instagram,
    href: "https://www.instagram.com/techsity_oficial/?igsh=1",
    label: "Instagram",
  },
  {
    Icon: TikTok,
    href: "https://www.tiktok.com/@techsitysolutions",
    label: "TikTok",
  },
];
---

<footer class="text-white bg-footer-bg">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 py-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Brand column -->
      <div class:list={[{ "reveal slide-up": animate }]}>
        <a href="/" class="text-2xl font-bold flex items-center gap-0.5 mb-5">
          <span
            class="bg-linear-to-r from-primary to-accent bg-clip-text text-transparent"
          >
            Tech
          </span>
          <Image
            src={logo}
            alt="Logo Techsity"
            width={25}
            height={25}
            class="w-auto h-[1em] inline-block"
          />
          <span
            class="bg-linear-to-r from-accent to-primary bg-clip-text text-transparent"
          >
            ity
          </span>
        </a>
        <p class="text-muted leading-relaxed text-sm max-w-xs mb-6">
          Somos tu socio tecnológico estratégico. Creamos soluciones digitales
          que impulsan el crecimiento y la innovación de tu empresa.
        </p>
        <div class="flex space-x-3">
          {
            socials.map(({ Icon, href, label }) => (
              <a
                href={href}
                aria-label={label}
                target={href !== "#" ? "_blank" : undefined}
                rel={href !== "#" ? "noopener noreferrer" : undefined}
                class="size-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-gray-400 hover:bg-primary hover:border-primary hover:text-white transition-all duration-300"
              >
                <Icon class="size-5" />
              </a>
            ))
          }
        </div>
      </div>

      <!-- Quick Links column -->
      <div class:list={[{ "reveal slide-up delay-100": animate }]}>
        <h4 class="text-sm font-semibold tracking-wider text-white mb-6">
          Navegación
        </h4>
        <ul class="space-y-4">
          {
            quickLinks.map(({ name, href }) => (
              <li>
                <a
                  href={href}
                  class="text-muted hover:text-primary transition-colors text-sm"
                >
                  {name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Contact column -->
      <div class:list={[{ "reveal slide-up delay-200": animate }]}>
        <h4 class="text-sm font-semibold tracking-wider text-white mb-6">
          Contacto
        </h4>
        <ul class="space-y-4">
          <li>
            <a
              href="mailto:techsitysolutions@gmail.com"
              class="flex items-center space-x-3 text-muted hover:text-primary transition-colors group"
            >
              <Mail
                class="size-5 shrink-0 group-hover:text-primary transition-colors"
              />
              <span class="text-sm">techsitysolutions@gmail.com</span>
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/584246209421?text=%C2%A1Hola%20Techsity!%20Vengo%20desde%20su%20p%C3%A1gina%20web%20y%20me%20gustar%C3%ADa%20conocer%20c%C3%B3mo%20pueden%20ayudarme%20a%20transformar%20mi%20proyecto%20con%20tecnolog%C3%ADa%20de%20vanguardia."
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center space-x-3 text-muted hover:text-primary transition-colors group"
            >
              <Phone
                class="size-5 shrink-0 group-hover:text-primary transition-colors"
              />
              <span class="text-sm">+58 424 620 9421</span>
            </a>
          </li>
          <li class="flex items-center space-x-3 text-muted">
            <MapPin class="size-5 shrink-0" />
            <span class="text-sm">Falcón, Venezuela</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class:list={[
        "border-t border-white/10 mt-12 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-muted",
        { "reveal fade-in delay-300": animate },
      ]}
    >
      <p>
        &copy; {currentYear} Techsity Solutions. Todos los derechos reservados.
      </p>
      <div class="flex items-center flex-wrap justify-center gap-x-5 gap-y-2">
        <a href="/legal/privacidad" class="hover:text-primary transition-colors"
          >Política de Privacidad</a
        >
        <span class="text-white/20">|</span>
        <a
          href="/legal/terminos-y-condiciones"
          class="hover:text-primary transition-colors">Términos de Servicio</a
        >
        <span class="text-white/20">|</span>
        <a href="/legal/cookies" class="hover:text-primary transition-colors"
          >Política de Cookies</a
        >
      </div>
    </div>
  </div>
</footer>

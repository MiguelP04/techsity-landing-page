---
import { Users, Zap, Cpu, Headphones } from "lucide-astro";

const benefits = [
  {
    title: "Enfoque Personalizado",
    description:
      "Cada proyecto es único. Analizamos tus necesidades específicas para crear soluciones que se adapten perfectamente a tu negocio y objetivos.",
    Icon: Users,
    highlight: "Tu visión, nuestra prioridad",
  },
  {
    title: "Desarrollo Ágil",
    description:
      "Entregamos resultados rápidos sin sacrificar calidad. Iteraciones constantes y comunicación transparente para que veas tu proyecto evolucionar.",
    Icon: Zap,
    highlight: "Resultados en semanas, no meses",
  },
  {
    title: "Tecnologías de Vanguardia",
    description:
      "Utilizamos las herramientas más modernas y eficientes del mercado, garantizando que tu producto sea escalable, seguro y preparado para el futuro.",
    Icon: Cpu,
    highlight: "Siempre a la vanguardia",
  },
  {
    title: "Soporte Continuo",
    description:
      "No te dejamos solo después del lanzamiento. Ofrecemos mantenimiento, actualizaciones y asistencia técnica para que tu producto siempre funcione al máximo.",
    Icon: Headphones,
    highlight: "Contigo en cada paso",
  },
];
---

<section
  id="por-que-elegirnos"
  class="py-24 bg-surface relative overflow-hidden"
>
  <!-- Decorative background elements -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="absolute top-0 left-1/4 w-72 h-72 bg-primary/10 rounded-full blur-3xl"
    >
    </div>
    <div
      class="absolute bottom-0 right-1/4 w-96 h-96 bg-secondary/10 rounded-full blur-3xl"
    >
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 overflow-hidden">
      <span
        class="inline-block px-4 py-2 bg-primary/10 text-primary font-semibold text-sm rounded-full mb-4 reveal fade-in delay-100"
      >
        Nuestras Ventajas
      </span>
      <h2
        class="text-3xl md:text-4xl lg:text-5xl font-bold text-heading mb-6 reveal slide-right"
      >
        ¿Por qué elegirnos?
      </h2>
      <p
        class="max-w-2xl mx-auto text-lg text-body leading-relaxed reveal slide-left delay-200"
      >
        Nos distinguimos por nuestra dedicación a transformar ideas en
        soluciones digitales que generan resultados reales y medibles.
      </p>
    </div>

    <!-- Benefits Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
      {
        benefits.map((benefit, index) => {
          const isEven = index % 2 === 0;
          const animationDirection = isEven ? "slide-left" : "slide-right";

          return (
            <div
              class={`group relative reveal ${animationDirection} delay-100`}
            >
              {/* Card */}
              <div
                class="relative h-full p-8 lg:p-10 bg-linear-to-br from-surface-alt to-surface rounded-3xl border hover:border-primary/30 transition-all duration-500 hover:shadow-2xl hover:shadow-primary/10 overflow-hidden"
                style="border-color: var(--color-border);"
              >
                {/* Animated gradient overlay on hover */}
                <div class="absolute inset-0 bg-linear-to-br from-primary/0 to-secondary/0 group-hover:from-primary/5 group-hover:to-secondary/5 transition-all duration-500" />

                {/* Number indicator */}
                <div class="absolute top-6 right-6 text-7xl font-bold text-border group-hover:text-primary/50 transition-colors duration-500 select-none">
                  0{index + 1}
                </div>

                <div class="relative z-10">
                  {/* Icon */}
                  <div class="w-16 h-16 bg-linear-to-br from-primary to-primary/80 rounded-2xl flex items-center justify-center text-white mb-6 shadow-lg shadow-primary/30 group-hover:scale-110 group-hover:rotate-3 transition-all duration-300">
                    <benefit.Icon class="w-8 h-8" />
                  </div>

                  {/* Content */}
                  <h3 class="text-2xl font-bold text-heading mb-3 group-hover:text-primary transition-colors duration-300">
                    {benefit.title}
                  </h3>

                  <p class="text-body leading-relaxed mb-4">
                    {benefit.description}
                  </p>

                  {/* Highlight tag */}
                  <div class="inline-flex items-center text-sm font-semibold text-primary">
                    <span class="w-2 h-2 bg-primary rounded-full mr-2 animate-pulse" />
                    {benefit.highlight}
                  </div>
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

---
import { Menu } from "lucide-astro";
import { Image } from "astro:assets";
import logo from "../assets/logo_transparent_small.svg";
import ThemeToggle from "./ThemeToggle.astro";
---

<nav
  class="fixed w-full z-50 backdrop-blur-md border-b transition-all duration-300"
  style="background-color: var(--color-surface-nav); border-color: var(--color-border);"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="text-2xl font-bold flex items-center gap-0.5">
          <span
            class="bg-linear-to-r from-primary to-secondary bg-clip-text text-transparent"
          >
            Tech
          </span>

          <Image
            src={logo}
            alt="Logo Techsity"
            width={25}
            height={25}
            class="w-auto h-[1em] inline-block"
          />

          <span
            class="bg-linear-to-r from-secondary to-primary bg-clip-text text-transparent"
          >
            ity
          </span>
        </a>
      </div>

      <div class="hidden lg:flex items-center space-x-8">
        <a
          href="#inicio"
          class="text-body hover:text-primary transition-colors font-medium"
          >Inicio</a
        >
        <a
          href="#servicios"
          class="text-body hover:text-primary transition-colors font-medium"
          >Servicios</a
        >
        <a
          href="#nosotros"
          class="text-body hover:text-primary transition-colors font-medium"
          >Sobre nosotros</a
        >
        <a
          href="#por-que-elegirnos"
          class="text-body hover:text-primary transition-colors font-medium"
          >¿Por qué elegirnos?</a
        >
        <a
          href="#contacto"
          class="text-body hover:text-primary transition-colors font-medium"
          >Contacto</a
        >
        <a
          href="#faq"
          class="text-body hover:text-primary transition-colors font-medium"
          >FAQ</a
        >
        <ThemeToggle />
        <a
          href="#contacto"
          class="px-5 py-2.5 rounded-full bg-primary text-white font-medium hover:brightness-110 transition-all shadow-lg shadow-primary/20"
        >
          Empezar
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="lg:hidden flex items-center gap-2">
        <ThemeToggle />
        <button
          class="mobile-menu-button p-2 rounded-lg text-body hover:text-primary hover:bg-primary/10 transition-all duration-300 focus:outline-none"
          aria-label="Abrir menú"
        >
          <Menu class="h-6 w-6" />
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile menu overlay (fuera del nav para evitar herencia de transparencia) -->
<div
  class="mobile-overlay fixed inset-0 bg-black/40 backdrop-blur-sm z-60 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
>
</div>

<!-- Mobile menu panel (fuera del nav) -->
<div
  class="mobile-menu fixed top-0 right-0 w-[85%] max-w-sm h-full shadow-2xl z-70 transform translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] lg:hidden"
  style="background-color: var(--color-surface-card);"
>
  <!-- Close button -->
  <div
    class="flex items-center justify-between px-6 h-16 border-b"
    style="border-color: var(--color-border);"
  >
    <a href="/" class="text-xl font-bold flex items-center gap-0.5">
      <span
        class="bg-linear-to-r from-primary to-secondary bg-clip-text text-transparent"
        >Tech</span
      >
      <Image
        src={logo}
        alt="Logo Techsity"
        width={20}
        height={20}
        class="w-auto h-[1em] inline-block"
      />
      <span
        class="bg-linear-to-r from-secondary to-primary bg-clip-text text-transparent"
        >ity</span
      >
    </a>
    <button
      class="mobile-menu-close w-10 h-10 flex items-center justify-center rounded-lg text-body hover:text-red-500 hover:bg-red-50 transition-all duration-300"
      aria-label="Cerrar menú"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Links -->
  <nav class="px-4 py-6">
    <div class="space-y-1">
      <a
        href="#inicio"
        class="mobile-link flex items-center gap-3 py-3.5 px-4 rounded-xl text-body-secondary font-medium hover:bg-primary/10 hover:text-primary transition-all duration-400 opacity-0 translate-x-8"
        style="transition-delay: 100ms"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span>
        Inicio
      </a>
      <a
        href="#servicios"
        class="mobile-link flex items-center gap-3 py-3.5 px-4 rounded-xl text-body-secondary font-medium hover:bg-primary/10 hover:text-primary transition-all duration-400 opacity-0 translate-x-8"
        style="transition-delay: 150ms"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span>
        Servicios
      </a>
      <a
        href="#nosotros"
        class="mobile-link flex items-center gap-3 py-3.5 px-4 rounded-xl text-body-secondary font-medium hover:bg-primary/10 hover:text-primary transition-all duration-400 opacity-0 translate-x-8"
        style="transition-delay: 200ms"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span>
        Sobre Nosotros
      </a>
      <a
        href="#por-que-elegirnos"
        class="mobile-link flex items-center gap-3 py-3.5 px-4 rounded-xl text-body-secondary font-medium hover:bg-primary/10 hover:text-primary transition-all duration-400 opacity-0 translate-x-8"
        style="transition-delay: 250ms"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span>
        ¿Por qué elegirnos?
      </a>
      <a
        href="#contacto"
        class="mobile-link flex items-center gap-3 py-3.5 px-4 rounded-xl text-body-secondary font-medium hover:bg-primary/10 hover:text-primary transition-all duration-400 opacity-0 translate-x-8"
        style="transition-delay: 300ms"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span>
        Contacto
      </a>
      <a
        href="#faq"
        class="mobile-link flex items-center gap-3 py-3.5 px-4 rounded-xl text-body-secondary font-medium hover:bg-primary/10 hover:text-primary transition-all duration-400 opacity-0 translate-x-8"
        style="transition-delay: 300ms"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-primary/40"></span>
        FAQ
      </a>
    </div>

    <!-- CTA Button -->
    <div class="mt-8 px-4">
      <a
        href="#contacto"
        class="mobile-link flex items-center justify-center w-full py-3.5 rounded-full bg-linear-to-r from-primary to-accent text-white font-semibold shadow-lg shadow-primary/30 hover:shadow-xl hover:scale-[1.02] transition-all duration-400 opacity-0 translate-x-8"
        style="transition-delay: 400ms"
      >
        Empezar Ahora
      </a>
    </div>
  </nav>
</div>

<script>
  const btn = document.querySelector("button.mobile-menu-button");
  const closeBtn = document.querySelector("button.mobile-menu-close");
  const menu = document.querySelector(".mobile-menu") as HTMLElement;
  const overlay = document.querySelector(".mobile-overlay") as HTMLElement;
  const mobileLinks = document.querySelectorAll(".mobile-link");

  function openMenu() {
    menu?.classList.remove("translate-x-full");
    menu?.classList.add("translate-x-0");

    overlay?.classList.remove("opacity-0", "pointer-events-none");
    overlay?.classList.add("opacity-100", "pointer-events-auto");

    requestAnimationFrame(() => {
      mobileLinks.forEach((link) => {
        link.classList.remove("opacity-0", "translate-x-8");
        link.classList.add("opacity-100", "translate-x-0");
      });
    });

    document.body.style.overflow = "hidden";
  }

  function closeMenu() {
    menu?.classList.add("translate-x-full");
    menu?.classList.remove("translate-x-0");

    overlay?.classList.add("opacity-0", "pointer-events-none");
    overlay?.classList.remove("opacity-100", "pointer-events-auto");

    mobileLinks.forEach((link) => {
      link.classList.add("opacity-0", "translate-x-8");
      link.classList.remove("opacity-100", "translate-x-0");
    });

    document.body.style.overflow = "";
  }

  btn?.addEventListener("click", openMenu);
  closeBtn?.addEventListener("click", closeMenu);
  overlay?.addEventListener("click", closeMenu);

  mobileLinks.forEach((link) => {
    link.addEventListener("click", closeMenu);
  });
</script>

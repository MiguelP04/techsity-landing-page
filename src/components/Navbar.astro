---
import { Menu } from "lucide-astro";
import { Image } from "astro:assets";
import logo from "../assets/logo_transparent_small.svg";
---

<nav
  class="fixed w-full z-50 bg-white/80 backdrop-blur-md border-b border-gray-100 transition-all duration-300"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-16">
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="text-2xl font-bold flex items-center gap-0.5">
          <span
            class="bg-linear-to-r from-primary to-secondary bg-clip-text text-transparent"
          >
            Tech
          </span>

          <Image
            src={logo}
            alt="Logo Techsity"
            width={25}
            height={25}
            class="w-auto h-[1em] inline-block"
          />

          <span
            class="bg-linear-to-r from-secondary to-primary bg-clip-text text-transparent"
          >
            ity
          </span>
        </a>
      </div>

      <div class="hidden md:flex items-center space-x-8">
        <a
          href="#inicio"
          class="text-gray-600 hover:text-primary transition-colors font-medium"
          >Inicio</a
        >
        <a
          href="#servicios"
          class="text-gray-600 hover:text-primary transition-colors font-medium"
          >Servicios</a
        >
        <a
          href="#nosotros"
          class="text-gray-600 hover:text-primary transition-colors font-medium"
          >Sobre nosotros</a
        >
        <a
          href="#por-que-elegirnos"
          class="text-gray-600 hover:text-primary transition-colors font-medium"
          >¿Por qué elegirnos?</a
        >
        <a
          href="#contacto"
          class="text-gray-600 hover:text-primary transition-colors font-medium"
          >Contacto</a
        >
        <a
          href="#contacto"
          class="px-5 py-2.5 rounded-full bg-primary text-white font-medium hover:brightness-110 transition-all shadow-lg shadow-primary/20"
        >
          Empezar
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="md:hidden flex items-center">
        <button
          class="mobile-menu-button p-2 rounded-md text-gray-600 hover:text-gray-900 focus:outline-none"
        >
          <Menu class="h-6 w-6" />
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    class="mobile-menu hidden md:hidden bg-white border-t border-gray-100 absolute w-full"
  >
    <a
      href="#inicio"
      class="block py-3 px-4 text-sm hover:bg-gray-50 text-gray-700">Inicio</a
    >
    <a
      href="#servicios"
      class="block py-3 px-4 text-sm hover:bg-gray-50 text-gray-700"
      >Servicios</a
    >
    <a
      href="#nosotros"
      class="block py-3 px-4 text-sm hover:bg-gray-50 text-gray-700">Nosotros</a
    >
    <a
      href="#contacto"
      class="block py-3 px-4 text-sm hover:bg-gray-50 text-gray-700">Contacto</a
    >
  </div>
</nav>

<script>
  const btn = document.querySelector("button.mobile-menu-button");
  const menu = document.querySelector(".mobile-menu");

  btn?.addEventListener("click", () => {
    menu?.classList.toggle("hidden");
  });
</script>

---
import {
  Globe,
  Smartphone,
  Lightbulb,
  ShoppingBag,
  Palette,
  TrendingUp,
} from "lucide-astro";

const services = [
  {
    title: "Desarrollo Web",
    description:
      "Sitios web rápidos, responsivos y optimizados para SEO utilizando las últimas tecnologías como Astro, React y Next.js.",
    Icon: Globe,
  },
  {
    title: "Apps Móviles",
    description:
      "Aplicaciones nativas y multiplataforma para iOS y Android que ofrecen una experiencia de usuario excepcional.",
    Icon: Smartphone,
  },
  {
    title: "Consultoría IT",
    description:
      "Asesoramiento experto para optimizar tus procesos tecnológicos y mejorar la eficiencia de tu empresa.",
    Icon: Lightbulb,
  },
  {
    title: "E-Commerce",
    description:
      "Tiendas en línea seguras y escalables diseñadas para maximizar tus ventas y conversión.",
    Icon: ShoppingBag,
  },
  {
    title: "Diseño UI/UX",
    description:
      "Interfaces intuitivas y atractivas que enamoran a tus usuarios desde el primer clic.",
    Icon: Palette,
  },
  {
    title: "Marketing Digital",
    description:
      "Estrategias de crecimiento para posicionar tu marca y alcanzar a tu audiencia ideal.",
    Icon: TrendingUp,
  },
];
---

<section id="servicios" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
        Nuestros Servicios
      </h2>
      <p class="mt-4 max-w-2xl mx-auto text-xl text-gray-500">
        Soluciones integrales diseñadas para cada etapa de tu crecimiento
        digital.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        services.map((service) => (
          <div class="group p-8 bg-gray-50 rounded-2xl border border-gray-100 hover:border-primary/50 hover:bg-primary/5 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 cursor-default">
            <div class="w-14 h-14 bg-white rounded-xl shadow-sm flex items-center justify-center text-primary mb-6 group-hover:scale-110 transition-transform duration-300">
              <service.Icon class="w-8 h-8" />
            </div>
            <h3 class="text-xl font-bold text-secondary mb-3">
              {service.title}
            </h3>
            <p class="text-paragraph leading-relaxed text-sm">
              {service.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  :root {
    --loader-bg: #f3f4f6;
    --accent-color: #ffffff;
    --glow-color: rgba(255, 255, 255, 0.8);
    --s0-color: #85bd2d;
    --s1-color: #189cd2;
    --s2-color: #193f7a;
  }

  .preloader {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--loader-bg);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    transition:
      opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
      visibility 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .preloader.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .logo-container {
    width: 150px;
    height: auto;
    display: flex;
    justify-content: center;
    align-items: center;
    animation: pulse 2.5s ease-in-out infinite;
  }

  .loader-svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Base styles for SVG paths using existing colors */
  .s0 {
    fill: var(--s0-color);
    opacity: 0.9;
  }
  .s1 {
    fill: var(--s1-color);
    opacity: 0.9;
  }
  .s2 {
    fill: var(--s2-color);
    opacity: 0.9;
  }

  /* Animated light streak effect */
  .animated-path {
    stroke: var(--accent-color);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 5px var(--glow-color));
    stroke-dasharray: 100 1000; /* Short segment of light */
    stroke-dashoffset: 0;
    animation: lightStreak 3s linear infinite;
  }

  #path-s1 {
    animation-delay: 0.5s;
  }
  #path-s2 {
    animation-delay: 1s;
  }

  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  @keyframes lightStreak {
    0% {
      stroke-dashoffset: 1100;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  /* Accessibility: Prevent scroll when loader is active */
  :global(body.loading) {
    overflow: hidden !important;
  }
</style>

<script is:inline>
  // Add loading class to body immediately
  document.body.classList.add("loading");
</script>

<script>
  window.addEventListener("load", () => {
    const preloader = document.getElementById("preloader");
    if (preloader) {
      // Small delay to ensure smooth start
      setTimeout(() => {
        preloader.classList.add("hidden");
        document.body.classList.remove("loading");

        // Remove from DOM after transition to avoid any impact
        setTimeout(() => {
          preloader.style.display = "none";
        }, 800);
      }, 500);
    }
  });
</script>

---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../assets/logo_transparent_small.svg";
import {
  ChevronLeft,
  Calendar,
  Shield,
  Clock,
  FileText,
  List,
} from "lucide-astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  sections: { id: string; label: string }[];
}

const {
  title,
  description = "Techsity Solutions – Información Legal",
  sections,
} = Astro.props;

const legalLinks = [
  { name: "Política de Privacidad", href: "/legal/privacidad" },
  { name: "Términos y Condiciones", href: "/legal/terminos-y-condiciones" },
  { name: "Política de Cookies", href: "/legal/cookies" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo_favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | Techsity Solutions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#f5f7fa] text-slate-800 font-sans antialiased">
    <!-- Reading progress bar (top of viewport) -->
    <div
      id="reading-progress"
      class="fixed top-0 left-0 h-0.5 bg-primary z-60 transition-all duration-100 ease-out"
      style="width: 0%"
    >
    </div>

    <!-- ── Header ── -->
    <header
      class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100"
    >
      <div
        class="max-w-7xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between gap-4"
      >
        <!-- Logo -->
        <a href="/" class="text-2xl font-bold flex items-center gap-0.5">
          <span
            class="bg-linear-to-r from-primary to-secondary bg-clip-text text-transparent"
          >
            Tech
          </span>

          <Image
            src={logo}
            alt="Logo Techsity"
            width={25}
            height={25}
            class="w-auto h-[1em] inline-block"
          />

          <span
            class="bg-linear-to-r from-secondary to-primary bg-clip-text text-transparent"
          >
            ity
          </span>
        </a>
        <!-- Back link -->
        <a
          href="/"
          class="group flex items-center gap-2 text-xs font-medium text-body hover:text-secondary transition-colors"
        >
          <span
            class="flex items-center justify-center w-7 h-7 rounded-full bg-gray-100 group-hover:bg-secondary group-hover:text-white transition-all duration-200"
          >
            <ChevronLeft class="size-3.5" />
          </span>
          Volver al inicio
        </a>
      </div>
    </header>

    <!-- ── Hero ── -->
    <div class="relative bg-secondary overflow-hidden">
      <!-- decorative blobs -->
      <div
        class="absolute -top-24 -right-24 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>
      <div
        class="absolute -bottom-16 -left-16 w-72 h-72 bg-accent/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>
      <!-- dot grid -->
      <div
        class="absolute inset-0 pointer-events-none opacity-[0.04]"
        style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>

      <div class="relative px-6 py-8 sm:px-10 sm:py-12">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-white/40 mb-5">
          <a href="/" class="hover:text-white/70 transition-colors">Inicio</a>
          <span>›</span>
          <span class="text-white/60">Legal</span>
          <span>›</span>
          <span class="text-primary font-medium">{title}</span>
        </nav>

        <div class="flex flex-col sm:flex-row sm:items-end gap-6">
          <div class="flex-1">
            <!-- Tag -->
            <div
              class="inline-flex items-center gap-1.5 bg-primary/15 border border-primary/25 rounded-full px-3 py-1 mb-4"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"
              ></span>
              <span
                class="text-[11px] font-semibold text-primary uppercase tracking-widest"
                >Documento Legal</span
              >
            </div>
            <h1
              class="text-3xl sm:text-4xl font-black text-white tracking-tight leading-tight"
            >
              {title}
            </h1>
          </div>

          <!-- Meta card -->
          <div
            class="shrink-0 bg-white/8 backdrop-blur-sm border border-white/10 rounded-2xl p-4 text-xs text-white/60 space-y-2 min-w-[170px]"
          >
            <div class="flex items-center gap-2">
              <Calendar
                class="size-3.5 text-primary shrink-0"
                strokeWidth="2"
              />
              <span>Actualizado Feb. 2026</span>
            </div>
            <div class="flex items-center gap-2">
              <Shield class="size-3.5 text-primary shrink-0" strokeWidth="2" />
              <span>LOPDP · RGPD</span>
            </div>
            <div class="flex items-center gap-2">
              <Clock class="size-3.5 text-primary shrink-0" strokeWidth="2" />
              <span>{sections.length} secciones</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Two-column layout ── -->
    <div class="py-10 lg:py-16">
      <div class="lg:grid lg:grid-cols-[300px_1fr] lg:gap-6 items-start">
        <!-- ── SIDEBAR ── -->
        <aside
          class="hidden lg:block sticky top-28 max-h-[calc(100vh-8rem)] overflow-y-auto pb-10 custom-scrollbar px-8 text-sm"
        >
          <div class="flex flex-col gap-10">
            <!-- TOC -->
            <div>
              <p
                class="text-xs font-bold text-slate-900 uppercase tracking-widest mb-4 px-1"
              >
                En esta página
              </p>
              <nav>
                <ul
                  class="space-y-1 border-l-2 border-gray-200/60"
                  id="toc-list"
                >
                  {
                    sections.map(({ id, label }) => (
                      <li>
                        <a
                          href={`#${id}`}
                          class="toc-link block relative -ml-[2px] pl-4 py-1.5 transition-all duration-150 text-slate-500 hover:text-slate-900 border-l-2 border-transparent"
                          data-section={id}
                        >
                          {label.replace(/^\d+\.\s*/, "")}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </nav>
            </div>

            <!-- Other docs -->
            <div>
              <p
                class="text-xs font-bold text-slate-900 uppercase tracking-widest mb-4 px-1"
              >
                Otros documentos
              </p>
              <ul class="space-y-1">
                {
                  legalLinks.map(({ name, href }) => {
                    const isActive = Astro.url?.pathname?.includes(href);
                    return (
                      <li>
                        <a
                          href={href}
                          class={`flex items-center gap-2.5 px-3 py-2 rounded-lg transition-all duration-150 ${isActive ? "bg-primary/10 text-primary font-semibold" : "text-slate-500 hover:bg-gray-200/50 hover:text-slate-900"}`}
                        >
                          <FileText
                            class={`size-4 shrink-0 ${isActive ? "text-primary" : "text-slate-400"}`}
                            strokeWidth="2"
                          />
                          {name}
                        </a>
                      </li>
                    );
                  })
                }
              </ul>
            </div>
          </div>
        </aside>

        <!-- ── MAIN CONTENT ── -->
        <main class="min-w-0">
          <!-- Mobile TOC -->
          <div
            class="lg:hidden mb-6 bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden mx-4"
          >
            <details>
              <summary
                class="flex items-center gap-2 px-5 py-4 text-sm font-semibold text-slate-700 cursor-pointer hover:bg-gray-50 transition-colors select-none"
              >
                <List class="size-4 text-primary shrink-0" strokeWidth="2" />
                Índice de contenidos
              </summary>
              <ul class="px-4 py-3 border-t border-gray-100 space-y-0.5">
                {
                  sections.map(({ id, label }) => (
                    <li>
                      <a
                        href={`#${id}`}
                        class="block text-sm text-body hover:text-secondary px-2 py-1.5 rounded-lg hover:bg-gray-50 transition-colors"
                      >
                        {label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </div>

          <!-- Content slot -->
          <div class="p-5 sm:p-10">
            <slot />
          </div>
        </main>
      </div>
    </div>

    <!-- ── Footer ── -->
    <Footer animate={false} />

    <script>
      // ── Reading progress bar ──
      const bar = document.getElementById("reading-progress");
      const tocBar = document.getElementById("toc-progress");

      function updateProgress() {
        const scrollTop = window.scrollY;
        const docHeight =
          document.documentElement.scrollHeight - window.innerHeight;
        const pct =
          docHeight > 0 ? Math.round((scrollTop / docHeight) * 100) : 0;
        if (bar) bar.style.width = pct + "%";
        if (tocBar) tocBar.style.width = pct + "%";
      }

      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();

      // ── Active TOC section ──
      const tocLinks =
        document.querySelectorAll<HTMLAnchorElement>(".toc-link");
      const sectionEls = Array.from(tocLinks)
        .map((l) => document.getElementById(l.dataset.section ?? ""))
        .filter(Boolean) as HTMLElement[];

      function activate(id: string) {
        tocLinks.forEach((link) => {
          const active = link.dataset.section === id;
          link.classList.toggle("border-primary", active);
          link.classList.toggle("text-primary", active);
          link.classList.toggle("font-semibold", active);
          link.classList.toggle("border-transparent", !active);
          link.classList.toggle("text-slate-500", !active);
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) activate(e.target.id);
          }
        },
        { rootMargin: "-15% 0px -75% 0px" },
      );

      sectionEls.forEach((el) => observer.observe(el));
      if (sectionEls[0]) activate(sectionEls[0].id);
    </script>
  </body>
</html>

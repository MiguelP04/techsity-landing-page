---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../assets/logo_transparent_small.svg";

interface Props {
  title: string;
  description?: string;
  sections: { id: string; label: string }[];
}

const {
  title,
  description = "Techsity Solutions – Información Legal",
  sections,
} = Astro.props;

const currentYear = new Date().getFullYear();

const legalLinks = [
  { name: "Términos y Condiciones", href: "/legal/terminos-y-condiciones" },
  { name: "Política de Privacidad", href: "/legal/privacidad" },
  { name: "Política de Cookies", href: "/legal/cookies" },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo_favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} | Techsity Solutions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#f5f7fa] text-slate-800 font-sans antialiased">
    <!-- Reading progress bar (top of viewport) -->
    <div
      id="reading-progress"
      class="fixed top-0 left-0 h-0.5 bg-primary z-[60] transition-all duration-100 ease-out"
      style="width: 0%"
    >
    </div>

    <!-- ── Header ── -->
    <header
      class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100"
    >
      <div
        class="max-w-7xl mx-auto px-5 sm:px-8 h-16 flex items-center justify-between gap-4"
      >
        <!-- Logo -->
        <a
          href="/"
          class="flex items-center gap-0.5 text-xl font-black tracking-tight"
        >
          <span class="text-primary">Tech</span>
          <Image
            src={logo}
            alt="Techsity logo"
            width={18}
            height={18}
            class="inline-block w-auto h-[1em]"
          />
          <span class="text-secondary">ity</span>
        </a>
        <!-- Back link -->
        <a
          href="/"
          class="group flex items-center gap-2 text-xs font-medium text-paragraph hover:text-secondary transition-colors"
        >
          <span
            class="flex items-center justify-center w-7 h-7 rounded-full bg-gray-100 group-hover:bg-secondary group-hover:text-white transition-all duration-200"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </span>
          Volver al inicio
        </a>
      </div>
    </header>

    <!-- ── Hero ── -->
    <div class="relative bg-secondary overflow-hidden">
      <!-- decorative blobs -->
      <div
        class="absolute -top-24 -right-24 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>
      <div
        class="absolute -bottom-16 -left-16 w-72 h-72 bg-accent/10 rounded-full blur-3xl pointer-events-none"
      >
      </div>
      <!-- dot grid -->
      <div
        class="absolute inset-0 pointer-events-none opacity-[0.04]"
        style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>

      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 py-16">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-xs text-white/40 mb-5">
          <a href="/" class="hover:text-white/70 transition-colors">Inicio</a>
          <span>›</span>
          <span class="text-white/60">Legal</span>
          <span>›</span>
          <span class="text-primary font-medium">{title}</span>
        </nav>

        <div class="flex flex-col sm:flex-row sm:items-end gap-6">
          <div class="flex-1">
            <!-- Tag -->
            <div
              class="inline-flex items-center gap-1.5 bg-primary/15 border border-primary/25 rounded-full px-3 py-1 mb-4"
            >
              <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"
              ></span>
              <span
                class="text-[11px] font-semibold text-primary uppercase tracking-widest"
                >Documento Legal</span
              >
            </div>
            <h1
              class="text-3xl sm:text-4xl font-black text-white tracking-tight leading-tight"
            >
              {title}
            </h1>
          </div>

          <!-- Meta card -->
          <div
            class="shrink-0 bg-white/8 backdrop-blur-sm border border-white/10 rounded-2xl p-4 text-xs text-white/60 space-y-2 min-w-[170px]"
          >
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-3.5 text-primary shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect width="18" height="18" x="3" y="4" rx="2" ry="2"
                ></rect><line x1="16" x2="16" y1="2" y2="6"></line><line
                  x1="8"
                  x2="8"
                  y1="2"
                  y2="6"></line><line x1="3" x2="21" y1="10" y2="10"
                ></line></svg
              >
              <span>Actualizado Feb. 2026</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-3.5 text-primary shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                ></path></svg
              >
              <span>LOPDP · RGPD</span>
            </div>
            <div class="flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-3.5 text-primary shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><circle cx="12" cy="12" r="10"></circle><polyline
                  points="12 6 12 12 16 14"></polyline></svg
              >
              <span>{sections.length} secciones</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Two-column layout ── -->
    <div class="max-w-7xl mx-auto px-5 sm:px-8 py-10">
      <div class="lg:grid lg:grid-cols-[280px_1fr] lg:gap-10 items-start">
        <!-- ── SIDEBAR ── -->
        <aside class="hidden lg:block">
          <div
            class="sticky top-16 h-[calc(100vh-4rem)] flex flex-col overflow-hidden"
          >
            <!-- TOC card -->
            <div
              class="flex-1 overflow-y-auto bg-white rounded-2xl border border-gray-200 shadow-sm"
            >
              <div class="p-5 border-b border-gray-100">
                <p
                  class="text-[10px] font-bold text-paragraph uppercase tracking-widest"
                >
                  Índice de contenidos
                </p>
              </div>

              <!-- Reading progress strip inside TOC -->
              <div class="h-0.5 bg-gray-100">
                <div
                  id="toc-progress"
                  class="h-full bg-primary transition-all duration-300 ease-out"
                  style="width:0%"
                >
                </div>
              </div>

              <nav class="p-3">
                <ul class="space-y-0.5" id="toc-list">
                  {
                    sections.map(({ id, label }, idx) => (
                      <li>
                        <a
                          href={`#${id}`}
                          class="toc-link group flex items-center gap-3 rounded-xl px-3 py-2.5 transition-all duration-150 text-paragraph hover:text-secondary hover:bg-gray-50"
                          data-section={id}
                        >
                          <span class="toc-num flex-shrink-0 w-5 h-5 rounded-full bg-gray-100 flex items-center justify-center text-[10px] font-bold text-paragraph group-hover:bg-secondary/10 group-hover:text-secondary transition-colors">
                            {idx + 1}
                          </span>
                          <span class="text-xs font-medium leading-snug">
                            {label.replace(/^\d+\.\s*/, "")}
                          </span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </nav>
            </div>

            <!-- Other docs card -->
            <div class="mt-3 bg-secondary rounded-2xl p-4 shrink-0">
              <p
                class="text-[10px] font-bold text-white/50 uppercase tracking-widest mb-3"
              >
                Otros documentos
              </p>
              <ul class="space-y-1">
                {
                  legalLinks.map(({ name, href }) => (
                    <li>
                      <a
                        href={href}
                        class="flex items-center gap-2 text-xs text-white/70 hover:text-white hover:bg-white/10 rounded-lg px-3 py-2 transition-all duration-150"
                      >
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="size-3 text-primary shrink-0"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <>
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <polyline points="14 2 14 8 20 8" />
                          </>
                        </svg>
                        {name}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </aside>

        <!-- ── MAIN CONTENT ── -->
        <main class="min-w-0">
          <!-- Mobile TOC -->
          <div
            class="lg:hidden mb-6 bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden"
          >
            <details>
              <summary
                class="flex items-center gap-2 px-5 py-4 text-sm font-semibold text-slate-700 cursor-pointer hover:bg-gray-50 transition-colors select-none"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-4 text-primary shrink-0"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  ><line x1="8" x2="21" y1="6" y2="6"></line><line
                    x1="8"
                    x2="21"
                    y1="12"
                    y2="12"></line><line x1="8" x2="21" y1="18" y2="18"
                  ></line><line x1="3" x2="3.01" y1="6" y2="6"></line><line
                    x1="3"
                    x2="3.01"
                    y1="12"
                    y2="12"></line><line x1="3" x2="3.01" y1="18" y2="18"
                  ></line></svg
                >
                Índice de contenidos
              </summary>
              <ul class="px-4 py-3 border-t border-gray-100 space-y-0.5">
                {
                  sections.map(({ id, label }) => (
                    <li>
                      <a
                        href={`#${id}`}
                        class="block text-sm text-paragraph hover:text-secondary px-2 py-1.5 rounded-lg hover:bg-gray-50 transition-colors"
                      >
                        {label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          </div>

          <!-- Content slot -->
          <div
            class="bg-white rounded-2xl border border-gray-200 shadow-sm p-8 sm:p-10"
          >
            <slot />
          </div>
        </main>
      </div>
    </div>

    <!-- ── Footer ── -->
    <footer class="bg-secondary mt-12">
      <div class="max-w-7xl mx-auto px-5 sm:px-8 py-8">
        <div
          class="flex flex-col sm:flex-row items-center justify-between gap-4"
        >
          <p class="text-xs text-white/40">
            &copy; {currentYear} Techsity Solutions. Todos los derechos reservados.
          </p>
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-1">
            {
              legalLinks.map(({ name, href }) => (
                <a
                  href={href}
                  class="text-xs text-white/50 hover:text-primary transition-colors"
                >
                  {name}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </footer>

    <script>
      // ── Reading progress bar ──
      const bar = document.getElementById("reading-progress");
      const tocBar = document.getElementById("toc-progress");

      function updateProgress() {
        const scrollTop = window.scrollY;
        const docHeight =
          document.documentElement.scrollHeight - window.innerHeight;
        const pct =
          docHeight > 0 ? Math.round((scrollTop / docHeight) * 100) : 0;
        if (bar) bar.style.width = pct + "%";
        if (tocBar) tocBar.style.width = pct + "%";
      }

      window.addEventListener("scroll", updateProgress, { passive: true });
      updateProgress();

      // ── Active TOC section ──
      const tocLinks =
        document.querySelectorAll<HTMLAnchorElement>(".toc-link");
      const sectionEls = Array.from(tocLinks)
        .map((l) => document.getElementById(l.dataset.section ?? ""))
        .filter(Boolean) as HTMLElement[];

      function activate(id: string) {
        tocLinks.forEach((link) => {
          const active = link.dataset.section === id;
          // link line
          link.classList.toggle("bg-primary/8", active);
          link.classList.toggle("text-secondary", active);
          link.classList.toggle("font-semibold", active);
          link.classList.toggle("text-paragraph", !active);
          // number bubble
          const num = link.querySelector(".toc-num");
          if (num) {
            num.classList.toggle("bg-primary", active);
            num.classList.toggle("text-white", active);
            num.classList.toggle("bg-gray-100", !active);
            num.classList.toggle("text-paragraph", !active);
          }
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) activate(e.target.id);
          }
        },
        { rootMargin: "-15% 0px -75% 0px" },
      );

      sectionEls.forEach((el) => observer.observe(el));
      if (sectionEls[0]) activate(sectionEls[0].id);
    </script>
  </body>
</html>

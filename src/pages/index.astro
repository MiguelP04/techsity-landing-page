---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Benefits from "../components/Benefits.astro";
import Footer from "../components/Footer.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
---

<Layout title="Techsity Solutions | Transformación Digital">
  <Navbar />
  <main>
    <Hero />
    <Services />
    <Benefits />

    <!-- Seccion Sobre Nosotros -->
    <section
      id="nosotros"
      class="py-20 bg-secondary text-white relative overflow-hidden"
    >
      <!-- Background patterns -->
      <div class="absolute inset-0 opacity-10">
        <div
          class="absolute right-0 top-0 w-96 h-96 bg-secondary rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"
        >
        </div>
        <div
          class="absolute left-0 bottom-0 w-96 h-96 bg-accent rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"
        >
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <h3 class="text-2xl font-bold text-center mb-12">
          Conoce a Nuestro Equipo
        </h3>
        <TestimonialCarousel />
      </div>
    </section>

    <!-- Call to Action -->
    <section class="py-20 bg-gray-50">
      <div class="max-w-4xl mx-auto px-4 text-center">
        <h2 class="text-3xl font-bold text-secondary mb-6">
          ¿Listo para comenzar tu próximo proyecto?
        </h2>
        <p class="text-xl text-paragraph mb-10">
          Agenda una llamada de descubrimiento gratuita de 15 minutos. Sin
          compromisos.
        </p>
        <a
          href="#contacto"
          class="inline-block px-8 py-4 rounded-full bg-primary text-white font-semibold text-lg hover:brightness-110 transition-all shadow-lg hover:shadow-primary/30"
        >
          Hablemos Ahora
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

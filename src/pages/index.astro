---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Benefits from "../components/Benefits.astro";
import Footer from "../components/Footer.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import ContactForm from "../components/ContactForm.astro";
import FAQ from "../components/FAQ.astro";
---

<Layout title="Techsity Solutions | Transformación Digital">
  <Navbar />
  <main>
    <Hero />
    <Services />
    <!-- Seccion Sobre Nosotros -->
    <section
      id="nosotros"
      class="py-24 bg-slate-950 text-white relative overflow-hidden"
    >
      <!-- Background Video with Blur and Dark Overlay -->
      <div class="absolute inset-0 z-0">
        <video
          autoplay
          muted
          loop
          playsinline
          class="w-full h-full object-cover opacity-30 blur-sm scale-105"
        >
          <source src="/videos/ourteam.webm" type="video/webm" />
        </video>
        <div
          class="absolute inset-0 bg-gradient-to-b from-slate-950 via-transparent to-slate-950 opacity-90"
        >
        </div>
        <div class="absolute inset-0 bg-secondary/40 mix-blend-multiply"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="reveal fade-in delay-200">
          <TestimonialCarousel />
        </div>
      </div>
    </section>

    <Benefits />

    <!-- Contact Form Section -->
    <ContactForm />

    <!-- FAQ Section -->
    <FAQ />
  </main>
  <Footer />
</Layout>

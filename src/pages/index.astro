---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Footer from "../components/Footer.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import ContactForm from "../components/ContactForm.astro";
import { Check } from "lucide-astro";
---

<Layout title="Techsity Solutions | Transformación Digital">
  <Navbar />
  <main>
    <Hero />
    <Services />

    <!-- Seccion Nosotros Breve -->
    <section
      id="nosotros"
      class="py-20 bg-secondary text-white relative overflow-hidden"
    >
      <!-- Background patterns -->
      <div class="absolute inset-0 opacity-10">
        <div
          class="absolute right-0 top-0 w-96 h-96 bg-secondary rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"
        >
        </div>
        <div
          class="absolute left-0 bottom-0 w-96 h-96 bg-accent rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"
        >
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="md:flex items-center gap-16">
          <div class="md:w-1/2 mb-10 md:mb-0">
            <img
              src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
              alt="Equipo Techsity"
              class="rounded-2xl shadow-2xl shadow-primary/20"
            />
          </div>
          <div class="md:w-1/2">
            <h2 class="text-3xl font-bold mb-6">¿Por qué elegirnos?</h2>
            <p class="text-gray-300 mb-6 leading-relaxed">
              En Techsity Solutions, no solo escribimos código; construimos el
              futuro de tu negocio. Nuestro enfoque combina excelencia técnica
              con una profunda comprensión de tus objetivos comerciales.
            </p>
            <ul class="space-y-4">
              <li class="flex items-center space-x-3">
                <Check class="w-5 h-5 text-primary" />
                <span>Metodologías Ágiles</span>
              </li>
              <li class="flex items-center space-x-3">
                <Check class="w-5 h-5 text-primary" />
                <span>Código Limpio y Escalable</span>
              </li>
              <li class="flex items-center space-x-3">
                <Check class="w-5 h-5 text-primary" />
                <span>Diseño Centrado en el Usuario</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- Testimonios de Desarrolladores -->
        <div class="mt-20 pt-16 border-t border-white/10">
          <h3 class="text-2xl font-bold text-center mb-12">
            Conoce a Nuestro Equipo
          </h3>
          <TestimonialCarousel />
        </div>
      </div>
    </section>

    <!-- Contact Form Section -->
    <ContactForm />
  </main>
  <Footer />
</Layout>
